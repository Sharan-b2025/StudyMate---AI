# Flask
SECRET_KEY=change-this-to-a-long-random-string
FLASK_DEBUG=1

# Database
# Leave DATABASE_URL unset to auto-use local SQLite (instance/studymate.db)
# On Render, this is provided automatically when you attach a PostgreSQL database.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# AI Provider (Gemini)
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# OCR (only needed if tesseract is not on default PATH)
# TESSERACT_CMD=/usr/bin/tesseract
